CREATE TABLE prototipo.disponibilidades (
    id_disponibilidad SERIAL PRIMARY KEY,
    id_usuario        INT NOT NULL,
    fecha             DATE NOT NULL,
    hora_inicio       TIME NOT NULL,
    hora_fin          TIME NOT NULL,
    id_tipo           INT NOT NULL,
    CONSTRAINT fk_disponibilidad_usuario
        FOREIGN KEY (id_usuario) REFERENCES prototipo.usuarios(id_usuario)
        ON DELETE CASCADE,
    CONSTRAINT fk_disponibilidad_tipo
        FOREIGN KEY (id_tipo) REFERENCES prototipo.tipos_disponibilidad(id_tipo),
    CONSTRAINT chk_horas_disponibilidad
        CHECK (hora_inicio < hora_fin)
);


--RF-12 

CREATE VIEW prototipo.vw_ocupaciones_usuarios AS

SELECT 
    u.id_usuario,
    u.nombre,
    u.apellido,
    e.fecha_inicio::DATE AS fecha,
    e.fecha_inicio::TIME AS hora_inicio,
    e.fecha_fin::TIME    AS hora_fin,
    'Evento' AS motivo
FROM prototipo.usuarios u
JOIN prototipo.eventos e ON e.id_usuario_propietario = u.id_usuario

UNION ALL

SELECT
    u.id_usuario,
    u.nombre,
    u.apellido,
    d.fecha,
    d.hora_inicio,
    d.hora_fin,
    td.nombre AS motivo
FROM prototipo.usuarios u
JOIN prototipo.disponibilidades d ON d.id_usuario = u.id_usuario
JOIN prototipo.tipos_disponibilidad td ON d.id_tipo = td.id_tipo
WHERE td.nombre IN ('Ocupado', 'No disponible');


---------- Modulo de TAREAS ----------

--RF-15

CREATE TABLE prototipo.tareas (
    id_tarea                SERIAL PRIMARY KEY,
    id_evento               INT NOT NULL,
    id_usuario_responsable  INT NOT NULL,
    titulo                  VARCHAR(100) NOT NULL,
    descripcion             TEXT,
    prioridad               VARCHAR(20) NOT NULL,
    fecha_limite            DATE NOT NULL,
    estado                  VARCHAR(20) NOT NULL DEFAULT 'Pendiente',
    fecha_creacion          DATE DEFAULT CURRENT_DATE,
    CONSTRAINT fk_tarea_evento
        FOREIGN KEY (id_evento) REFERENCES prototipo.eventos(id_evento)
        ON DELETE CASCADE,
    CONSTRAINT fk_tarea_responsable
        FOREIGN KEY (id_usuario_responsable) REFERENCES prototipo.usuarios(id_usuario)
        ON DELETE CASCADE,
    CONSTRAINT chk_prioridad
        CHECK (prioridad IN ('Baja', 'Media', 'Alta')),
    CONSTRAINT chk_estado
        CHECK (estado IN ('Pendiente', 'En progreso', 'Completada', 'Cancelada'))
);
